{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "herdr",
  "title": "Herdr Agents",
  "description": "Inspect and control Herdr coding agents from Raycast.",
  "icon": "icon.png",
  "author": "kuroweb",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "agents",
      "title": "Agents",
      "description": "Herdrの稼働中agentを一覧し、focus・prompt送信・出力確認を行う。",
      "mode": "view",
      "keywords": [
        "herdr",
        "agent",
        "claude",
        "terminal",
        "status"
      ],
      "preferences": [
        {
          "name": "agentGrouping",
          "title": "Grouping",
          "description": "agentをまとめる単位。",
          "type": "dropdown",
          "required": false,
          "default": "space",
          "data": [
            {
              "title": "space",
              "value": "space"
            },
            {
              "title": "status",
              "value": "status"
            }
          ]
        }
      ]
    },
    {
      "name": "spaces",
      "title": "Spaces",
      "description": "Herdrのworkspaceを一覧し、フォーカス・作成・ラベル変更・クローズを行う。",
      "mode": "view",
      "keywords": [
        "herdr",
        "workspace",
        "space",
        "project"
      ]
    },
    {
      "name": "agent-status",
      "title": "Agent Status",
      "description": "稼働中agentの状態をメニューバーに常時表示する。",
      "mode": "menu-bar",
      "interval": "30s",
      "keywords": [
        "herdr",
        "agent",
        "status"
      ]
    },
    {
      "name": "open-herdr",
      "title": "Open Herdr",
      "description": "ターミナルの新規ウィンドウでHerdrを起動、または既存セッションにattachする。",
      "mode": "no-view",
      "keywords": [
        "herdr",
        "terminal",
        "attach",
        "session"
      ]
    }
  ],
  "preferences": [
    {
      "name": "herdrPath",
      "title": "Herdr Binary",
      "description": "herdrコマンドの絶対パス。RaycastはログインシェルのPATHを継承しないため絶対パスが必要。",
      "type": "textfield",
      "required": false,
      "default": "/opt/homebrew/bin/herdr"
    },
    {
      "name": "terminalApp",
      "title": "Terminal App",
      "description": "focus時に前面化し、Open HerdrでHerdrを起動するターミナルアプリ。未設定ならTerminalを使う。",
      "type": "appPicker",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.5.3",
    "@raycast/utils": "^2.2.4"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json"
  }
}
